# ==============================================================================
# INFINITO 2K26 - LOCAL DEVELOPMENT ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Instructions: Copy this file to '.env' in the root directory before running 
# the local setup scripts or Prisma migrations. Do NOT commit the actual '.env'.

NODE_ENV=development
PORT=3000

# ─── DATABASE SETTINGS (PostgreSQL Container) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=infinito_dev_pwd
POSTGRES_DB=infinito_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Connection URL mapping directly to our postgres container
DATABASE_URL="postgresql://postgres:infinito_dev_pwd@localhost:5432/infinito_dev?schema=public"

# ─── CACHE & QUEUE SETTINGS (Redis Container) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── OBJECT STORAGE SETTINGS (Cloudinary) ─────────────────────────────────────
# These are read by the NestJS ConfigModule / Zod schema (env.schema.ts).
# Get these from the Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── AUTH & SIGNING SECRETS ────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-here
QR_SIGNING_SECRET=change-me-qr-signing-secret-minimum-32-characters