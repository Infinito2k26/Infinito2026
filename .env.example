# ==============================================================================
# INFINITO 2K26 - LOCAL DEVELOPMENT ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Instructions: Copy this file to '.env' in the root directory before running 
# the local setup scripts or Prisma migrations. Do NOT commit the actual '.env'.

NODE_ENV=local

# ─── DATABASE SETTINGS (PostgreSQL Container) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Dr0pT@ble_Dr0pMyW1ll2L1v3!_99
POSTGRES_DB=infinito_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Connection URL mapping directly to our postgres container
DATABASE_URL="postgresql://postgres:local_dev_password@localhost:5432/infinito_dev?schema=public"

# ─── CACHE & QUEUE SETTINGS (Redis Container) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── OBJECT STORAGE SETTINGS (MinIO Container) ────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=K1ckTh3Buck3t!_m1n10
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=infinito-assets

# AWS-S3 SDK compatibility mode variables for local development
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_admin_password
AWS_REGION=us-east-1
S3_ENDPOINT="http://localhost:9000"