{
  "name": "infinito-2k26",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "type-check": "turbo run check-types",
    "db:seed": "tsc prisma/seed.ts --outDir dist && node dist/prisma/seed.js",
    "test:coverage": "echo 'Tests pending...' && exit 0"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.17",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
