NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:infinito_dev_pwd@localhost:5432/infinito_dev"
REDIS_URL="redis://localhost:6379"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Dev-only placeholders, >= 32 chars. Regenerate with `openssl rand -base64 48` for production.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
QR_SIGNING_SECRET="dev-only-qr-secret-change-me-please-32chars"

# Web app origin, used for CORS and building links (e.g. password reset) sent by email
WEB_ORIGIN="http://localhost:3001"

# Optional: leave unset locally to just log password-reset links instead of emailing them
RESEND_API_KEY=""
EMAIL_FROM="Infinito 2K26 <no-reply@infinito2k26.dev>"

# Optional: leave unset locally to skip error tracking entirely
SENTRY_DSN=""
