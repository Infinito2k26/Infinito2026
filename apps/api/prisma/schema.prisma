generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  passwordHash      String?
  name              String
  phone             String?
  role              UserRole           @default(PARTICIPANT)
  college           String?
  isIITP            Boolean            @default(false)
  brandId           String?            @db.Uuid
  iitpEmail         String?            @unique
  isIITPVerified    Boolean            @default(false)
  isEmailVerified   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  caProfile         CAProfile?
  taskVerifications CATaskAssignment[] @relation("TaskVerifier")
  credentials       Credential?        @relation("UserCredentials")
  rulebooksUploaded EventRulebook[]    @relation("RulebookUploader")
  participants      Participant[]      @relation("UserParticipant")
  registrations     Registration[]     @relation("IndividualRegistrations")
  scansDone         ScanLog[]          @relation("VolunteerScans")
  captainedTeams    Team[]             @relation("TeamCaptain")
  brand             Brand?             @relation("BrandUsers", fields: [brandId], references: [id])

  @@index([isIITP, role])
  @@index([brandId])
}

model Event {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  slug                String                @unique
  broadCategory       BroadCategory
  sportCategory       String
  description         String?
  pointOfContactName  String?
  pointOfContactPhone String?
  registrationType    EventRegistrationType
  genderCategory      GenderCategory
  teamSizeMin         Int?
  teamSizeMax         Int?
  maxSubstitutes      Int?
  viceCaptainRequired Boolean               @default(true)
  coachAllowed        Boolean               @default(false)
  feeStructure        FeeStructure
  feeFlat             Decimal?              @db.Decimal(10, 2)
  feePerHead          Decimal?              @db.Decimal(10, 2)
  feeMale             Decimal?              @db.Decimal(10, 2)
  feeFemale           Decimal?              @db.Decimal(10, 2)
  startDate           DateTime
  endDate             DateTime?
  venue               String?
  hasAccommodation    Boolean               @default(false)
  accommodationRate   Decimal?              @db.Decimal(10, 2)
  prizePool           Decimal?              @db.Decimal(10, 2)
  capacity            Int?
  customFieldsDef     Json?
  isPublished         Boolean               @default(false)
  registrationOpen    Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  caTasks             CaTask[]
  rulebooks           EventRulebook[]
  subOptions          EventSubOption[]
  registrations       Registration[]

  @@index([isPublished, registrationOpen])
  @@index([broadCategory])
}

model EventSubOption {
  id                     String                  @id @default(uuid()) @db.Uuid
  eventId                String                  @db.Uuid
  name                   String
  type                   SubOptionType
  maxSelectionsPerReg    Int
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  event                  Event                   @relation(fields: [eventId], references: [id])
  registrationSubOptions RegistrationSubOption[]

  @@index([eventId, isActive])
}

model EventRulebook {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  title        String
  fileUrl      String
  version      String?
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])
  uploadedBy   User     @relation("RulebookUploader", fields: [uploadedById], references: [id])
}

model Team {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  captainId        String        @db.Uuid
  collegeName      String
  collegeAddress   String?
  isIITP           Boolean       @default(false)
  viceCaptainName  String?
  viceCaptainPhone String?
  coachName        String?
  coachPhone       String?
  inviteCode       String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  participants     Participant[]
  registration     Registration?
  captain          User          @relation("TeamCaptain", fields: [captainId], references: [id])

  @@index([isIITP])
}

model Participant {
  id         String          @id @default(uuid()) @db.Uuid
  teamId     String          @db.Uuid
  name       String
  phone      String?
  role       ParticipantRole
  isRequired Boolean
  userId     String?         @db.Uuid
  photoUrl   String
  idType     IdentityType
  idNumber   String
  idFileUrl  String
  customData Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  credential Credential?     @relation("ParticipantCredential")
  team       Team            @relation(fields: [teamId], references: [id])
  user       User?           @relation("UserParticipant", fields: [userId], references: [id])

  @@index([teamId, role])
}

model CAProfile {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @unique @db.Uuid
  refCode               String               @unique
  assignedCollegeName   String
  referralCount         Int                  @default(0)
  totalPoints           Int                  @default(0)
  rank                  Int?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id])
  socialAccounts        CASocialAccount[]
  taskAssignments       CATaskAssignment[]
  referralConversions   ReferralConversion[]
  referredRegistrations Registration[]       @relation("ReferredRegistrations")
  socialReferrals       SocialReferral[]

  @@index([isActive])
  @@index([assignedCollegeName])
  @@index([totalPoints])
}

model SocialPlatformConfig {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique
  displayName     String
  isActive        Boolean           @default(true)
  oauthEnabled    Boolean           @default(false)
  canVerifyAction Boolean           @default(false)
  oauthScopes     String[]
  verifyEndpoint  String?
  metricsDef      Json
  constraintsDef  Json?
  attributesDef   Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  socialAccounts  CASocialAccount[]
  caTasks         CaTask[]
  socialReferrals SocialReferral[]

  @@index([isActive])
}

model CASocialAccount {
  id          String               @id @default(uuid()) @db.Uuid
  caId        String               @db.Uuid
  platformId  String               @db.Uuid
  accountId   String
  handle      String
  accessToken String?
  tokenExpiry DateTime?
  connectedAt DateTime             @default(now())
  caProfile   CAProfile            @relation(fields: [caId], references: [id])
  platform    SocialPlatformConfig @relation(fields: [platformId], references: [id])

  @@unique([caId, platformId])
  @@index([platformId])
}

model Brand {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  logoUrl      String?
  contactName  String?
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        CaTask[]
  users        User[]   @relation("BrandUsers")

  @@index([isActive])
}

model CaTask {
  id               String                @id @default(uuid()) @db.Uuid
  title            String
  description      String
  category         TaskCategory
  source           TaskSource
  brandId          String?               @db.Uuid
  platformId       String?               @db.Uuid
  targetMetric     String?
  targetCount      Int?
  targetContentUrl String?
  points           Int
  deadline         DateTime?
  proofType        ProofType             @default(SCREENSHOT)
  isActive         Boolean               @default(true)
  eventId          String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  assignments      CATaskAssignment[]
  brand            Brand?                @relation(fields: [brandId], references: [id])
  event            Event?                @relation(fields: [eventId], references: [id])
  platform         SocialPlatformConfig? @relation(fields: [platformId], references: [id])
  referrals        SocialReferral[]

  @@index([source, isActive])
  @@index([brandId])
  @@index([eventId])
  @@index([platformId])
}

model CATaskAssignment {
  id            String     @id @default(uuid()) @db.Uuid
  caId          String     @db.Uuid
  taskId        String     @db.Uuid
  status        TaskStatus @default(PENDING)
  proofUrl      String?
  proofNote     String?
  fetchedStats  Json?
  pointsAwarded Int?
  submittedAt   DateTime?
  verifiedAt    DateTime?
  verifiedById  String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  caProfile     CAProfile  @relation(fields: [caId], references: [id])
  task          CaTask     @relation(fields: [taskId], references: [id])
  verifiedBy    User?      @relation("TaskVerifier", fields: [verifiedById], references: [id])

  @@unique([caId, taskId])
  @@index([status])
  @@index([caId, status])
  @@index([taskId, status])
}

model SocialReferral {
  id                String               @id @default(uuid()) @db.Uuid
  caId              String               @db.Uuid
  platformId        String               @db.Uuid
  taskId            String?              @db.Uuid
  verifiedUserId    String
  verifiedHandle    String
  sessionToken      String?
  verificationLevel VerificationLevel
  attributes        Json?
  metrics           Json?
  createdAt         DateTime             @default(now())
  caProfile         CAProfile            @relation(fields: [caId], references: [id])
  platform          SocialPlatformConfig @relation(fields: [platformId], references: [id])
  task              CaTask?              @relation(fields: [taskId], references: [id])

  @@unique([platformId, verifiedUserId])
  @@index([caId, platformId])
  @@index([taskId])
}

model Registration {
  id                     String                  @id @default(uuid()) @db.Uuid
  eventId                String                  @db.Uuid
  teamId                 String?                 @unique @db.Uuid
  userId                 String?                 @db.Uuid
  status                 RegistrationStatus      @default(PENDING_PAYMENT)
  isIITP                 Boolean                 @default(false)
  genderDeclared         GenderCategory?
  accommodationOpted     Boolean                 @default(false)
  accommodationDays      Int?
  accommodationHeadcount Int?
  referredById           String?                 @db.Uuid
  customData             Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  credentials            Credential[]
  payments               Payment[]
  referralConversion     ReferralConversion?
  event                  Event                   @relation(fields: [eventId], references: [id])
  referredBy             CAProfile?              @relation("ReferredRegistrations", fields: [referredById], references: [id])
  team                   Team?                   @relation(fields: [teamId], references: [id])
  user                   User?                   @relation("IndividualRegistrations", fields: [userId], references: [id])
  subOptions             RegistrationSubOption[]

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([referredById])
}

model RegistrationSubOption {
  id             String         @id @default(uuid()) @db.Uuid
  registrationId String         @db.Uuid
  subOptionId    String         @db.Uuid
  relayMembers   Json?
  registration   Registration   @relation(fields: [registrationId], references: [id])
  subOption      EventSubOption @relation(fields: [subOptionId], references: [id])
}

model ReferralConversion {
  id             String       @id @default(uuid()) @db.Uuid
  caId           String       @db.Uuid
  registrationId String       @unique @db.Uuid
  createdAt      DateTime     @default(now())
  caProfile      CAProfile    @relation(fields: [caId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@index([caId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  registrationId   String        @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  mode             PaymentMode
  status           PaymentStatus @default(INITIATED)
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  screenshotUrl    String?
  transactionId    String?
  webhookVerified  Boolean       @default(false)
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  registration     Registration  @relation(fields: [registrationId], references: [id])
}

model Credential {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  participantId  String?      @unique @db.Uuid
  userId         String?      @unique @db.Uuid
  tokenHash      String       @unique
  qrImageUrl     String
  scanCount      Int          @default(0)
  lastScannedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  participant    Participant? @relation("ParticipantCredential", fields: [participantId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])
  user           User?        @relation("UserCredentials", fields: [userId], references: [id])
  scanLogs       ScanLog[]
}

model ScanLog {
  id           String        @id @default(uuid()) @db.Uuid
  credentialId String        @db.Uuid
  scannedById  String        @db.Uuid
  gate         String
  direction    ScanDirection
  result       ScanResult
  metadata     Json?
  createdAt    DateTime      @default(now())
  credential   Credential    @relation(fields: [credentialId], references: [id])
  scannedBy    User          @relation("VolunteerScans", fields: [scannedById], references: [id])

  @@index([credentialId, createdAt])
  @@index([gate, direction, createdAt])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  VOLUNTEER
  CAMPUS_AMBASSADOR
  BRAND
  PARTICIPANT
}

enum BroadCategory {
  OUTDOOR
  INDOOR
  ESPORTS
  CULTURAL
  TECHNICAL
}

enum EventRegistrationType {
  INDIVIDUAL
  TEAM
}

enum GenderCategory {
  OPEN
  MEN
  WOMEN
}

enum FeeStructure {
  FLAT
  PER_HEAD
  GENDER_BASED
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  FILE
}

enum CustomFieldScope {
  TEAM
  PARTICIPANT
}

enum SubOptionType {
  INDIVIDUAL
  RELAY
}

enum ParticipantRole {
  CAPTAIN
  VICE_CAPTAIN
  PLAYER
  SUBSTITUTE
}

enum IdentityType {
  COLLEGE_ID
  AADHAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  ONLINE
  MANUAL_SCREENSHOT
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  RECONCILIATION_PENDING
}

enum ScanDirection {
  ENTRY
  EXIT
}

enum ScanResult {
  VALID
  INVALID
  DUPLICATE
  EXPIRED
}

enum VerificationLevel {
  BEHAVIORAL
  API_CONFIRMED
}

enum TaskSource {
  MODERATOR
  BRAND
}

enum TaskCategory {
  REFERRAL
  SOCIAL_MEDIA
  PHYSICAL
  CONTENT
  COMMUNITY
}

enum ProofType {
  AUTO
  URL_SUBMISSION
  SCREENSHOT
  PHOTO
}

enum TaskStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}
