NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:infinito_dev_pwd@localhost:5433/infinito_test
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=test-cloud-name
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret
JWT_ACCESS_SECRET=test-jwt-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=test-jwt-refresh-secret-minimum-32-characters
QR_SIGNING_SECRET=test-qr-signing-secret-minimum-32-characters
# Explicit, not left to fall through to .env — auth.e2e-spec.ts's login
# throttling test hardcodes an expectation of exactly this limit.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
